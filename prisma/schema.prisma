generator client {
  provider = "prisma-client-js"
}

// La base se conectó vía el marketplace de Neon en Vercel, que antepone el
// nombre del proyecto a cada variable para evitar colisiones si se conectan
// varias bases (CRM_CUANTICO_POSTGRES_PRISMA_URL en vez de POSTGRES_PRISMA_URL).
datasource db {
  provider  = "postgresql"
  url       = env("CRM_CUANTICO_POSTGRES_PRISMA_URL")
  directUrl = env("CRM_CUANTICO_POSTGRES_URL_NON_POOLING")
}

// Cartera activa actual (hoja DATOS). Mezcla pólizas ya renovadas para el ciclo
// (vencimiento en el año siguiente) con pólizas pendientes de renovar
// (vencimiento pasado o próximo). DÍAS AL VENCE y EDAD no se almacenan: se
// recalculan en cada consulta a partir de vencimiento / fechaNacimiento.
model Policy {
  id                Int       @id @default(autoincrement())
  numero            String // PÓLIZA
  ramo              String
  asegurado         String
  ccNit             String?
  placa             String?
  aseguradora       String?
  tipoNegocio       String? // NUEVO, RENOVACION, COASEGURO, INCLUSIÓN, ...
  // Columna OBSERVACION del informe (añadida en julio de 2026). Es la nota
  // que escribe el área técnica; no confundir con notaCartera, que es la
  // observación de cobranza que se edita dentro de la aplicación.
  observacion       String?
  asesor1           String?
  asesor2           String?
  primaNeta         Float     @default(0)
  primaTotal        Float     @default(0)
  formaPago         String?
  fechaPago         DateTime? // fecha del último pago recibido
  fechaMaxPago      DateTime? // fecha límite del próximo pago (o de la próxima cuota)
  estadoPago        String? // OK PAGO / PENDIENTE
  // Pagos fraccionados (MENSUAL, ACUERDO DE PAGO, FINANCIADO…): valor de la
  // cuota pactada. El informe de cartera lo muestra como "Cuota: $…".
  valorCuota        Float?
  // Observación de cobranza que aparece en el informe de cartera
  // (p. ej. "PENDIENTE AMPLIACIÓN", "BLIN SE ENCARGA DE LOS RECAUDOS").
  notaCartera       String?
  // Cuándo se tocó la cobranza DENTRO de la aplicación (registrar un pago,
  // pactar una cuota, escribir una observación de cartera). Mientras esté
  // puesta, la reimportación del Excel NO pisa los campos de cobranza de esta
  // póliza: manda el CRM, que es donde se registra el recaudo al día. Con la
  // fecha en null la póliza sigue tomando la cobranza del informe.
  cobranzaEditadaEn DateTime?
  // Cuándo se renovó la póliza DESDE la aplicación.
  //
  // La importación borra y recrea la cartera, así que una renovación hecha en
  // el CRM se perdía en la siguiente carga: el Excel devolvía el tipo de
  // negocio y el vencimiento viejos, y la póliza volvía a aparecer como NUEVO
  // y pendiente de renovar. Con esta fecha puesta manda el CRM.
  //
  // Se limpia sola: en cuanto el Excel trae un vencimiento igual o posterior
  // al del CRM, es que el informe ya recogió la renovación y vuelve a mandar
  // él. Sin eso, la póliza quedaría congelada y la renovación del año
  // siguiente no entraría nunca.
  renovadaEn        DateTime?
  // Número de la póliza colectiva madre cuando esta fila es un recibo suyo
  // (una inclusión). Lo escribe `aplicarMapaColectivas` a partir de
  // ReciboColectiva, no viene del Excel. Con valor, la póliza NO sale en
  // vencimientos ni cuenta aparte en producción: se gestiona desde colectivas.
  colectivaDe       String?
  // true = creada DENTRO de la aplicación, no importada del Excel.
  //
  // La importación borra y recrea la cartera, así que sin esta marca cualquier
  // póliza dada de alta en el CRM —una colectiva que la operación gestiona aquí,
  // una que el informe dejó de traer— desaparecía en la siguiente carga. Las
  // manuales se conservan; si el Excel acaba trayendo la misma póliza, manda el
  // Excel y la copia manual se retira para no duplicarla.
  manual            Boolean   @default(false)
  vencimiento       DateTime?
  mesVencimiento    String? // derivado del vencimiento al importar
  fechaNacimiento   DateTime?
  correo            String?
  celular           String?
  mensajeResumen    String?
  vtoSoat           DateTime?
  // Gestión interna de renovación (no viene del Excel)
  gestionada        Boolean   @default(false)
  notaGestion       String?
  gestionadaEn      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  endosos           Endoso[]

  @@index([colectivaDe])
  @@index([vencimiento])
  @@index([ramo])
  @@index([numero])
  @@index([asegurado])
}

// Hoja OTRAS PÓLIZAS (pólizas fuera del seguimiento de vencimientos: viaje, etc.)
model OtherPolicy {
  id              Int       @id @default(autoincrement())
  numero          String
  ramo            String
  asegurado       String
  ccNit           String?
  tipoNegocio     String?
  asesor1         String?
  asesor2         String?
  primaNeta       Float     @default(0)
  primaTotal      Float     @default(0)
  formaPago       String?
  fechaPago       DateTime?
  fechaMaxPago    DateTime?
  estadoPago      String?
  vencimiento     DateTime?
  fechaNacimiento DateTime?
  correo          String?
  celular         String?
  createdAt       DateTime  @default(now())

  @@index([numero])
  @@index([asegurado])
}

// Hoja CANCELACIONES.
// fechaRenovacion alimenta "PRODUCCIÓN CANCELADA" (agrupada por mes de renovación).
// fechaCancelacion alimenta "CANCELACIONES" (agrupada por mes real de cancelación).
// Son métricas distintas y no se mezclan.
model Cancellation {
  id               Int       @id @default(autoincrement())
  numero           String
  ramo             String
  fechaRenovacion  DateTime?
  fechaCancelacion DateTime?
  tipoNegocio      String?
  asegurado        String?
  ccNit            String?
  placa            String?
  asesor           String?
  aseguradora      String?
  primaNeta        Float     @default(0)
  primaTotal       Float     @default(0)
  // Por qué se canceló (no viene del Excel; se escribe al cancelar en la app).
  motivo           String?
  // true = creada dentro de la app (al cancelar una póliza desde la cartera).
  // La reimportación del Excel solo reemplaza las cancelaciones NO manuales,
  // así el trabajo de los asesores no se pierde al volver a cargar el archivo.
  manual           Boolean   @default(false)
  createdAt        DateTime  @default(now())

  @@index([fechaRenovacion])
  @@index([fechaCancelacion])
  @@index([ramo])
}

// Hoja BASE 2025: histórico que define la BASE PARA RENOVAR del seguimiento 2026.
model HistoricalPolicy2025 {
  id          Int       @id @default(autoincrement())
  numero      String
  ramo        String
  vencimiento DateTime?
  mes         String? // columna MES de la hoja (coincide con el mes del vencimiento)
  tipoNegocio String?
  asegurado   String?
  primaNeta   Float     @default(0)
  primaTotal  Float     @default(0)

  @@index([ramo])
}

// Siniestros. Vienen de dos archivos que la agencia mantenía por separado:
//  · "20260617 SEGUIMIENTO SINIESTROS.xlsx", con UNA HOJA POR CLIENTE (46) y
//    el detalle del caso (fechas, radicado, observaciones, valores).
//  · "SINIESTROS.xlsx", un resumen con el responsable y las cifras.
// Aquí quedan todos en una sola lista.
model Siniestro {
  id                     Int       @id @default(autoincrement())
  asegurado              String
  nit                    String?
  firmaAdministracion    String?
  administrador          String?
  celular                String?
  email                  String?
  aseguradora            String?
  poliza                 String?
  vigenciaPoliza         DateTime?
  cobertura              String? // evento avisado
  resumen                String?
  fechaOcurrencia        DateTime?
  fechaAvisoAsesor       DateTime?
  fechaAvisoCompania     DateTime?
  radicado               String? // número de siniestro
  // Texto original del estado, tal como lo escribieron.
  estadoTexto            String?
  // Estado normalizado para poder filtrar y contar: el original trae decenas
  // de variantes y erratas ("COPROPEIDAD", "PAGOSO", "PAGODO").
  estado                 String    @default("SIN_ESTADO")
  observaciones          String?
  valorSiniestro         Float? // pretensión
  valorLiquidar          Float? // establecido por la aseguradora
  valorPagado            Float?
  deducible              Float?
  fechaPago              DateTime?
  otrosDatos             String?
  empleadoCompania       String?
  telefonoCompania       String?
  correoCompania         String?
  responsable            String? // asesor a cargo (del resumen)
  fechaUltimoSeguimiento DateTime?
  // Gestión dentro de la aplicación
  notaInterna            String?
  cerrado                Boolean   @default(false)
  /// Hoja o archivo de procedencia, para poder auditar de dónde salió.
  origen                 String?
  /// true = creado o editado en la app; la reimportación no lo sobrescribe.
  manual                 Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([asegurado])
  @@index([estado])
  @@index([aseguradora])
  @@index([responsable])
}

// Empleados con acceso al CRM. La clave nunca se guarda en claro: se almacena
// como "scrypt$<sal>$<hash>" (ver lib/auth.ts).
model Usuario {
  id        Int      @id @default(autoincrement())
  usuario   String   @unique
  nombre    String?
  claveHash String
  activo    Boolean  @default(true)
  creadoEn  DateTime @default(now())
  sesiones  Sesion[]
}

// Sesiones activas. El token vive en una cookie httpOnly y se valida contra
// esta tabla en cada petición, de modo que se puede revocar el acceso
// borrando la fila.
model Sesion {
  token     String   @id
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expira    DateTime
  creadoEn  DateTime @default(now())

  @@index([usuarioId])
}

// Hoja LISTAS: valores válidos para validación y dropdowns.
// tipo ∈ RAMO | TIPO_NEGOCIO | ESTADO_PAGO | FORMA_PAGO | ASEGURADORA | ASESOR
model ListValue {
  id    Int    @id @default(autoincrement())
  tipo  String
  valor String

  @@unique([tipo, valor])
  @@index([tipo])
}

// ---------------------------------------------------------------------------
// Colectivas
//
// Una póliza colectiva la contrata una EMPRESA para sus empleados, y lo que se
// gestiona a diario no es la póliza sino el movimiento de personas dentro de
// ella: quién entra (inclusión) y quién sale (retiro).
//
// La estructura sale de cómo se lleva hoy en el SharePoint
// (4. Asesores/Oficina/<EMPRESA>): un empleado AFILIADO puede traer
// beneficiarios —cónyuge, hijos, padres— y cada persona cubierta tiene su
// propio valor asegurado y su propia prima. Por eso el afiliado no es la
// unidad: la unidad es la PERSONA cubierta, colgada del empleado que le da
// derecho.
//
// Estas tablas NO las toca la importación del informe de producción: se
// alimentan aparte, porque el informe trae la póliza como un total y aquí hace
// falta el detalle por persona.
// ---------------------------------------------------------------------------

// Foto de la cartera al cierre de un año de producción.
//
// POR QUÉ EXISTE
//
// `Policy` guarda la cartera de HOY, y una póliza renovada mueve su
// vencimiento al año siguiente. Como la producción del año N se mide por las
// pólizas que vencen en N+1, renovar una póliza la borra de la producción del
// año en que se vendió. Medido sobre la cartera viva, 2025 rinde $2.752M
// cuando la hoja BASE 2025 dice $6.138M: la diferencia son las 352 pólizas
// que ya se renovaron y se llevaron su vencimiento a 2027. Sin esta foto,
// cada año cerrado se desvanece a lo largo del año siguiente.
//
// Es lo que `HistoricalPolicy2025` hacía para 2025, pero sin una tabla nueva
// por año: aquí el año es un dato, no un nombre de tabla.
//
// Se guarda fila por fila, no el agregado por ramo y mes, para que el listado
// de vencimientos de un año pasado también se pueda consultar.
model FotoPoliza {
  id Int @id @default(autoincrement())
  // Año de PRODUCCIÓN al que pertenece la foto (las pólizas que vencen en
  // anioProduccion + 1).
  anioProduccion Int
  tomadaEn       DateTime @default(now())

  numero      String
  ramo        String
  asegurado   String
  ccNit       String?
  placa       String?
  aseguradora String?
  tipoNegocio String?
  observacion String?
  asesor1     String?
  asesor2     String?
  primaNeta   Float    @default(0)
  primaTotal  Float    @default(0)
  formaPago   String?
  estadoPago  String?
  vencimiento DateTime?

  // Sin llave única: el informe trae pólizas repetidas (mismo número y ramo en
  // dos filas, p. ej. una colectiva con dos formas de pago) y la foto debe
  // reflejar la cartera tal como estaba, no una versión depurada. La toma
  // borra y reescribe el año entero.
  @@index([anioProduccion])
  @@index([vencimiento])
}

// Una póliza COLECTIVA MADRE: la que representa a todo el grupo.
//
// Existe para dos cosas que el informe de producción no sabe hacer:
//
//  1. Darle un nombre de ramo propio («Colectiva Salud», «Colectiva Autos»,
//     «Colectiva Vida»). El informe las mete todas bajo COLECTIVA, VIDA GRUPO
//     o SALUD, y así no se pueden separar en el dashboard ni en vencimientos.
//  2. Ser el punto al que se cuelgan los recibos de inclusión.
model ColectivaMadre {
  numero String @id
  // Nombre con el que la póliza aparece en TODA la aplicación.
  ramo   String

  empresaId Int?
  empresa   EmpresaColectiva? @relation(fields: [empresaId], references: [id], onDelete: SetNull)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  recibos ReciboColectiva[]

  @@index([empresaId])
}

// Un recibo que pertenece a una colectiva y NO es una póliza independiente.
//
// En el informe cada inclusión llega como su propia fila, con su número y su
// prima, y acaba apareciendo en vencimientos como si hubiera que renovarla una
// a una. No hay que renovarla: se renueva la colectiva. Estas filas se
// absorben en su madre y se gestionan desde el módulo de colectivas.
//
// La PLACA hace falta para desempatar: hay números de póliza que aparecen dos
// veces, una como madre y otra como inclusión de un vehículo concreto
// (2000691934 y su PWY867). Se guarda cadena vacía cuando no aplica, y no
// null, porque en Postgres dos NULL no chocan entre sí y la llave única
// dejaría de servir.
model ReciboColectiva {
  id     Int    @id @default(autoincrement())
  numero String
  placa  String @default("")

  colectivaNumero String
  colectiva       ColectivaMadre @relation(fields: [colectivaNumero], references: [numero], onDelete: Cascade)

  nota     String?
  creadoEn DateTime @default(now())

  @@unique([numero, placa])
  @@index([colectivaNumero])
}

model EmpresaColectiva {
  id            Int      @id @default(autoincrement())
  nombre        String   @unique
  nit           String?
  // Carpeta del SharePoint, para saltar al expediente sin buscarlo.
  carpeta       String?
  activa        Boolean  @default(true)
  nota          String?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  amparados AmparadoColectiva[]
  novedades NovedadColectiva[]
  madres    ColectivaMadre[]
}

// Una persona cubierta por una póliza colectiva.
model AmparadoColectiva {
  id        Int              @id @default(autoincrement())
  empresaId Int
  empresa   EmpresaColectiva @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  // Póliza a la que pertenece. Se guarda el número tal cual, sin relación con
  // Policy: la reimportación del informe borra y recrea esa tabla, y una
  // llave foránea dejaría huérfanos los amparados en cada carga.
  polizaNumero String
  ramo         String // VIDA GRUPO | COLECTIVA | SALUD…
  plan         String? // CLASICA, GLOBAL, PREFERENCIAL…

  // El empleado que da derecho a la cobertura.
  docEmpleado    String
  nombreEmpleado String

  // La persona cubierta. Coincide con el empleado cuando parentesco = AF.
  docAmparado    String
  nombreAmparado String
  // AF = afiliado (el propio empleado) · CO = cónyuge · HI = hijo ·
  // PR = padre/madre · HE = hermano · DE = dependiente · VE = vehículo
  //
  // VE existe porque no todas las colectivas son de personas: las de AUTOS
  // (Logiter, y las de Cristica y Espumas Medellín) amparan vehículos. El
  // amparado es entonces la placa, y el «empleado» es su propietario.
  parentesco     String
  sexo           String?

  // Solo en colectivas de autos (parentesco VE).
  placa          String?

  valorAsegurado Float?
  primaMensual   Float?

  // Trámite ante la aseguradora.
  estado      String  @default("EN EXPEDICION") // EXPEDIDO, EN EXPEDICION, EN EVALUACION, RETIRADO…
  radicado    String?
  observacion String?

  fechaIngreso DateTime?
  fechaRetiro  DateTime?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  novedades NovedadColectiva[]

  // Reimportar el listado de la aseguradora no debe duplicar gente. No se usa
  // el documento porque los beneficiarios vienen sin él en los débitos: solo
  // nombre y parentesco. Dentro de una póliza, el empleado más el nombre del
  // amparado sí identifican la fila.
  @@unique([polizaNumero, docEmpleado, nombreAmparado])
  @@index([empresaId])
  @@index([polizaNumero])
  @@index([docAmparado])
  @@index([estado])
}

// Bitácora de movimientos. Se guarda aparte del amparado porque lo que se
// audita es el HISTORIAL: cuándo se pidió un retiro, cuándo lo confirmó la
// aseguradora y con qué radicado. Un solo campo de estado en el amparado
// perdería eso en cuanto se sobrescribe.
model NovedadColectiva {
  id         Int                @id @default(autoincrement())
  empresaId  Int
  empresa    EmpresaColectiva   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  amparadoId Int?
  amparado   AmparadoColectiva? @relation(fields: [amparadoId], references: [id], onDelete: SetNull)

  tipo           String // INCLUSION | RETIRO | MODIFICACION
  fecha          DateTime // fecha efectiva del movimiento
  estado         String   @default("SOLICITADA") // SOLICITADA | CONFIRMADA | RECHAZADA
  radicado       String?
  // Se copian nombre y documento para que la bitácora siga siendo legible
  // aunque el amparado se borre después.
  nombreAmparado String
  docAmparado    String
  nota           String?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([empresaId])
  @@index([fecha])
  @@index([tipo])
}

// Cotizaciones que todavía no son póliza: las que están en trámite y las que
// se perdieron. Viven aparte de Policy a propósito — un prospecto no tiene
// número de póliza, ni prima, ni vencimiento, y mezclarlo con la cartera
// obligaría a dejar medio modelo en null y a filtrarlo en cada consulta.
model Prospecto {
  id            Int      @id @default(autoincrement())
  // Nombre de la copropiedad o del cliente potencial.
  nombre        String
  // Cuándo arranca la vigencia que se está cotizando: es la fecha contra la
  // que se corre, porque pasada esa fecha la oportunidad se pierde sola.
  fechaInicio   DateTime?
  administrador String?
  compania      String?
  // Estado tal como lo escribe el equipo, sin tocar: «ESCOGIERON INTERMEDIARIO
  // ANTERIOR», «PENDIENTE DE INFORMACION PARA COTIZAR»… Es lo que se lee.
  estado        String?
  // El anterior reducido a PENDIENTE | PERDIDA | GANADA, para poder contar y
  // filtrar. Se deriva del texto al guardar; ver lib/prospectos.ts.
  situacion     String   @default("PENDIENTE")
  asesor        String?
  nota          String?
  // Si se gana, aquí queda el número de la póliza que salió de este prospecto.
  polizaNumero  String?
  // Bitácora de la gestión, igual que las observaciones de un siniestro: cada
  // nota se antepone con su fecha, de modo que lo último queda arriba. Es un
  // solo campo de texto y no una tabla aparte porque lo que se necesita es
  // leerlo de corrido, no consultarlo ni contarlo.
  historia          String?
  // Cuándo se tocó por última vez. Un prospecto que lleva semanas sin
  // movimiento es tan revelador como uno con la vigencia encima.
  ultimoSeguimiento DateTime?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([situacion])
  @@index([fechaInicio])
}

// ---------------------------------------------------------------------------
// Endosos
//
// Un ENDOSO es el certificado que le dice al banco «de la póliza de áreas
// comunes de este edificio, la parte que le corresponde al apartamento 1406
// queda a su favor por $X». Se emite porque el propietario sacó un crédito
// hipotecario o un leasing y el banco exige ser beneficiario del seguro; como
// el apartamento ya está cubierto por la póliza de la copropiedad, no se
// expide una póliza nueva.
//
// El trámite lo devuelve el banco con una frecuencia altísima —227 reprocesos
// entre abril y agosto de 2026 sobre 2.163 correos, y 118 solo en julio— y casi
// siempre por lo mismo: la dirección no coincide con la registrada en el
// crédito, el beneficiario o su NIT están mal, o el paz y salvo no está al día.
// Por eso el modelo guarda la dirección desmenuzada en piezas (ciudad, torre,
// apartamento, cuarto útil, parqueadero) en vez de un solo campo de texto: solo
// así se puede avisar QUÉ falta antes de radicar. Ver lib/endosos.ts.
// ---------------------------------------------------------------------------

// La ficha del edificio: lo que hay que saber ANTES de tramitar cualquier
// endoso suyo. Se llena una vez y sirve para todos los apartamentos.
//
// Reemplaza dos hojas del Excel «ENDOSOS DÍA A DÍA» que hoy llevan esto suelto:
// «Importante» (si la copropiedad admite endosos hoy) y «Consolidado» (hasta
// cuándo va su paz y salvo).
model Copropiedad {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  nit    String?

  // La calle y la ciudad del edificio. Van aquí y no en cada endoso porque son
  // del edificio: los cien apartamentos de Marsella comparten la misma
  // nomenclatura. Escribirlas caso por caso era teclear cien veces lo mismo y
  // de ahí salían las variantes que hacen dudar al banco. Son además la
  // «dirección de la copropiedad» que piden las planillas de AXA y Zurich.
  direccion String?
  ciudad    String?

  aseguradora   String?
  numeroPoliza  String?
  // Hasta cuándo va la vigencia de la póliza de áreas comunes.
  vigenciaHasta DateTime?

  // Valor asegurado del EDIFICIO completo. Es el que se multiplica por el
  // coeficiente del apartamento para saber cuánto le corresponde a cada uno.
  valorAseguradoTotal Float?

  // Certificado de pago. Sin él la aseguradora no emite el endoso, y BBVA y
  // Davivienda además exigen que diga textualmente «Pagado en su Totalidad».
  pazSalvoVigenteHasta DateTime?
  pazSalvoEstado       String? // AL DIA | POR VENCER | VENCIDO | SIN PAZ Y SALVO

  // Semáforo de una sola pregunta: ¿se pueden enviar endosos de este edificio
  // hoy? Se guarda a mano y no se deduce de las fechas porque hay motivos que
  // ninguna fecha refleja —«la póliza no cubre áreas privadas», «está en
  // proceso de renovación»— y son justo los que hacen perder el trámite.
  admiteEndosos  Boolean @default(true)
  motivoBloqueo  String?

  nota String?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  endosos Endoso[]

  @@index([admiteEndosos])
}

// Cada pasada de la revisión automática del buzón de endosos.
//
// Sirve para una pregunta que se hace a diario mirando el tablero: «¿esto que
// estoy viendo está al día?». Sin el registro no hay forma de distinguir un
// buzón tranquilo de una revisión que dejó de correr, y la diferencia entre
// las dos cosas es justo la que importa.
model RevisionBuzon {
  id          Int      @id @default(autoincrement())
  ejecutadaEn DateTime @default(now())

  // Correos mirados en la pasada y casos que de verdad cambiaron.
  correosNuevos Int @default(0)
  casosTocados  Int @default(0)

  // Qué modelo la hizo, y un resumen en una línea de lo que encontró.
  modelo  String?
  resumen String?

  @@index([ejecutadaEn])
}

model Endoso {
  id Int @id @default(autoincrement())

  copropiedadId Int?
  copropiedad   Copropiedad? @relation(fields: [copropiedadId], references: [id], onDelete: SetNull)
  // Se guarda además el nombre en texto para que el caso siga siendo legible
  // aunque todavía no se haya creado la ficha del edificio. La solicitud llega
  // por correo antes de que nadie dé de alta la copropiedad.
  urbanizacion  String

  // Deudor principal y, cuando el crédito es de dos, el segundo. En leasing
  // estos dos son los LOCATARIOS y el propietario es el banco.
  cliente String
  cedula  String?
  cliente2 String?
  cedula2  String?

  correoSolicitante String?
  celular           String?

  // La dirección va partida a propósito: la causa nº 1 de devolución es que no
  // coincida exactamente con la registrada en el crédito, y en piezas se puede
  // avisar cuál falta.
  direccion   String?
  ciudad      String?
  torre       String?
  apartamento String?
  cuartoUtil  String?
  parqueadero String?

  // Coeficiente de copropiedad del apartamento, en porcentaje (0.36 = 0,36%).
  // Juan lo digita cuando lo consigue y queda guardado: el año siguiente, en la
  // renovación del mismo apartamento, ya no hay que volver a pedirlo.
  coeficiente Float?

  // Lo que pide el banco.
  valorSolicitado Float?
  banco           String?
  bancoNit        String?
  tipoCredito     String? // HIPOTECARIO | LEASING

  // Trámite ante la aseguradora.
  aseguradora           String?
  numeroPoliza          String?
  radicado              String?
  fechaEnvioAseguradora DateTime?

  // Cuándo se le entregaron los documentos al cliente. Es la cifra con la que
  // se mide el trabajo del mes, así que vive en su propio campo y no se deduce
  // del estado: un caso puede volver a reproceso y seguir siendo cierto que
  // ese día se entregó.
  fechaEnvioCliente DateTime?

  estado String @default("NUEVA_SOLICITUD")

  // Bitácora, mismo formato que Prospecto.historia y Siniestro: cada nota se
  // antepone con su fecha y no se borra nunca lo anterior.
  historia          String?
  ultimoSeguimiento DateTime?

  // internetMessageId del correo que originó el caso, para poder volver al hilo
  // sin buscarlo a mano.
  origenCorreoId String?

  // Póliza de la cartera con la que se emparejó, si se encontró. Es opcional y
  // se confirma a mano: el nombre del cliente en un correo rara vez coincide
  // letra por letra con el asegurado del informe.
  policyId Int?
  policy   Policy? @relation(fields: [policyId], references: [id], onDelete: SetNull)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([estado])
  @@index([copropiedadId])
  @@index([aseguradora])
  @@index([cliente])
  @@index([policyId])
}
