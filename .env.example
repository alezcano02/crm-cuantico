# Base de datos conectada vía el marketplace de Neon en Vercel. Al conectarla,
# Vercel antepone el nombre del proyecto a cada variable para evitar
# colisiones si se conecta más de una base (por eso el prefijo CRM_CUANTICO_).
# Copie los valores reales desde Vercel: proyecto → Settings →
# Environment Variables (o "vercel env pull .env").
#
# Cadena con pooling (para la app / Prisma Client)
CRM_CUANTICO_POSTGRES_PRISMA_URL="postgres://usuario:password@host:5432/db?sslmode=require&pgbouncer=true&connect_timeout=15"
# Cadena directa sin pooling (para migraciones / prisma db push)
CRM_CUANTICO_POSTGRES_URL_NON_POOLING="postgres://usuario:password@host:5432/db?sslmode=require"

# ---------------------------------------------------------------------------
# Tarea programada de endosos (app/api/cron/procesar-endosos). Lee el buzón
# endosos@cuanticoseguros.com por su cuenta, cada hora, sin depender de una
# sesión interactiva ni de Claude Code.
# ---------------------------------------------------------------------------

# Registro de aplicación en Azure AD (Entra ID) del tenant cuanticoseguros.com,
# con permiso de APLICACIÓN (no delegado) Mail.Read sobre Microsoft Graph,
# consentido por un administrador. Ver Azure AD → Registros de aplicaciones →
# CRM Cuántico - Lectura Endosos.
MICROSOFT_TENANT_ID=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Clave de la API de Anthropic (console.anthropic.com), para clasificar y
# extraer los datos de cada correo.
ANTHROPIC_API_KEY=""

# Cadena aleatoria propia (no la genera ningún proveedor externo). Vercel la
# manda en la cabecera Authorization de cada disparo del cron, y la ruta la
# compara para asegurarse de que la llamada viene de verdad de Vercel y no de
# cualquiera que adivine la URL. Generar con: openssl rand -hex 32
CRON_SECRET=""
