# Vercel Postgres (se crean automáticamente al conectar la base en Vercel)
# Cadena con pooling (para la app / Prisma Client)
POSTGRES_PRISMA_URL="postgres://usuario:password@host:5432/db?sslmode=require&pgbouncer=true&connect_timeout=15"
# Cadena directa sin pooling (para migraciones / prisma db push)
POSTGRES_URL_NON_POOLING="postgres://usuario:password@host:5432/db?sslmode=require"
